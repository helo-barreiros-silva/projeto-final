algoritmo "Quociente e resto da divisão"

var
num1, num2, quoc, resto: real

inicio

escreva("Digite o primeiro número: ")
leia(num1)
escreva("Digite o primeiro número: ")
leia(num2)
quoc <- num1/num2
resto <- num1%num2

escreval("O quociente da divisão é: ", quoc)
escreval("O resto da divisão é: ", resto)

fimalgoritmo