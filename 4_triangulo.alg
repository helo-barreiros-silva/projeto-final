algoritmo "perimetro triangulo"

var
l1, l2,l3, per: real

inicio

escreval("Digite o lado 1 do triângulo: ")
leia(l1)
escreval("Digite o lado 2 do triângulo: ")
leia(l2)
escreval("Digite o lado 3 do triângulo: ")
leia(l3)

per <- l1 +l2 +l3


escreval("O perímetro do triaângulo é: ", per)

fimalgoritmo