algoritmo "Area e perímetro do retangulo"

var

altura, base, area, per: real

inicio

escreval("Digite o tamanho da base: ")
leia(base)
escreval("Digite o tamanho da altura: ")
leia(altura)

area <- base*altura
per <- (base*2) + (altura*2)
escreval("A área do retângulo é: ", area)
escreval("O perímetro do retângulo é: ", per)




fimalgoritmo