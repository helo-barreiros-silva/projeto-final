algoritmo "vogal ou consoante"

var
letra: caractere

inicio

escreval("Digite um letra e vamos falar se é consoante ou vogal")
leia(letra)
se (letra = "a") ou (letra = "e") ou (letra = "i") ou (letra = "o") ou (letra = "u") entao
    escreval ("é vogal")
senao
    escreval ("é consoante")
fimse
fimalgoritmo